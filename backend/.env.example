# Server Configuration
HOST=127.0.0.1
PORT=8000

# Gemini API configuration (optional; local fallback works without a key)
# Create/manage your key in Google AI Studio. Keep the real key private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase configuration (optional; local JSON storage works without credentials)
SUPABASE_URL=
SUPABASE_KEY=
